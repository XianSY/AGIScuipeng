            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }    
        ]
    }
    
    withName:BEDTOOLS_INTER_METHYLATION_INDEL{
        publishDir = [
            path:{ "${params.outdir}/meQTL/06.pureMethlation/08.bedtools_inter_me_indel" },
            mode: params.publish_dir_mode,
            pattern: "*",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }    
        ]
    }

    withName:BEDTOOLS_INTER_METHYLATION_REPEATMASKER{
        publishDir = [
            path:{ "${params.outdir}/meQTL/06.pureMethlation/09.repeatmasker_results" },
            mode: params.publish_dir_mode,
