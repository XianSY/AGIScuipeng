        ]
    }
    withName: PICARD_COLLECTMULTIPLEMETRICS {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling/MultipleMetrics" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: PICARD_COLLECTINSERTSIZEMETRICS {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling/InsertSizeMetrics" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: SAMTOOLS_DEPTH {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling/Depth" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta1.id}_depth"}
        ext.args={"-a"}
    }
    withName: GATK4_CREATESEQUENCEDICTIONARY {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/03_genome_faidx" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
    }
    withName: GATK4_HAPLOTYPECALLER_PREPARE {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_raw"}
    }
    withName: GATK4_SELECTVARIANTS_SNP {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_raw_snp"}
        ext.args={"-select-type SNP"}
    }
    withName: GATK4_SELECTVARIANTS_INDEL {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_raw_indel"}
        ext.args={"-select-type INDEL"}
    }
    withName: GATK4_VARIANTFILTRATION_SNP {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_raw_snp_filtered"}
        ext.args={
        '-filter-name '+'"'+'QD_filter'+'"'+' -filter '+'"'+'QD < 2.0'+'"'+
        ' -filter-name '+'"'+'FS_filter'+'"'+' -filter '+'"'+'FS > 60.0'+'"'+
        ' -filter-name '+'"'+'MQ_filter'+'"'+' -filter '+'"'+'MQ < 40.0'+'"'+
        ' -filter-name '+'"'+'SOR_filter'+'"'+' -filter '+'"'+'SOR > 4.0'+'"'+
        ' -filter-name '+'"'+'MQRankSum_filter'+'"'+' -filter '+'"'+'MQRankSum < -12.5'+'"'+
        ' -filter-name '+'"'+'ReadPosRankSum_filter'+'"'+' -filter '+'"'+'ReadPosRankSum < -8.0'+'"'
        }
    }
    withName: GATK4_VARIANTFILTRATION_INDEL {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_raw_indel_filtered"}
        ext.args={
        '-filter-name '+'"'+'QD_filter'+'"'+' -filter '+'"'+'QD < 2.0'+'"'+
        ' -filter-name '+'"'+'FS_filter'+'"'+' -filter '+'"'+'FS > 200.0'+'"'+
        ' -filter-name '+'"'+'SOR_filter'+'"'+' -filter '+'"'+'SOR > 10.0'+'"'
        }
    }
    withName: GATK4_SELECTVARIANTS_SNP_BQ {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_for_bqsr_snp"}
        ext.args={'--exclude-filtered'}
    }
    withName: GATK4_SELECTVARIANTS_INDEL_BQ {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_for_bqsr_indel"}
        ext.args={'--exclude-filtered'}
    }
    withName: GATK4_BASERECALIBRATOR {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_bqsr"}
    }
    withName: GATK4_APPLYBQSR {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_bqsr"}
    }
    withName: SAMTOOLS_INDEX_BQSR {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_bqsr"}
    }
    withName: GATK4_BASERECALIBRATOR_FORSTAT {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling/bqsr_qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_bqsrstat"}
    }
    withName: GATK4_ANALYZECOVARIATES {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/04_pre_calling/bqsr_qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_bqsrstat"}
    }
    withName: GATK4_HAPLOTYPECALLER_GVCF{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/05_gvcf" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.args={"-ERC GVCF"}
        ext.prefix={"${meta.id}.g"}
    }
}
//population variants calling

process {
    withName: GET_CHROMSOME_LST {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/03_genome_faidx" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
    }
    withName: GATK4_GENOMICSDBIMPORT {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/06_genomicdb" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.args={"--genomicsdb-shared-posixfs-optimizations true --batch-size 100"}
    }
    withName: GATK4_GENOTYPEGVCFS{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args={"-G StandardAnnotation -new-qual"}
    }
    withName: GATK4_GATHERVCFS{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: GATK4_SELECTVARIANTS_SNP_HQ{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix={"${meta.id}_snp_forhq"}
        ext.args={"-select-type SNP"}
    }
    withName: GATK4_SELECTVARIANTS_INDEL_HQ{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix={"${meta.id}_indel_forhq"}
        ext.args={"-select-type INDEL"}
    }
    withName: GATK4_VARIANTFILTRATION_SNP_FOR_VQ {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_snp_hq"}
        ext.args={
        '-filter-name '+'"'+'QD_filter'+'"'+' -filter '+'"'+'QD < 2.0'+'"'+
        ' -filter-name '+'"'+'QUAL_filter'+'"'+' -filter '+'"'+'QUAL < 30.0'+'"'+
        ' -filter-name '+'"'+'FS_filter'+'"'+' -filter '+'"'+'FS > 60.0'+'"'+
        ' -filter-name '+'"'+'MQ_filter'+'"'+' -filter '+'"'+'MQ < 40.0'+'"'+
        ' -filter-name '+'"'+'SOR_filter'+'"'+' -filter '+'"'+'SOR > 3.0'+'"'+
        ' -filter-name '+'"'+'MQRankSum_filter'+'"'+' -filter '+'"'+'MQRankSum < -12.5'+'"'+
        ' -filter-name '+'"'+'ReadPosRankSum_filter'+'"'+' -filter '+'"'+'ReadPosRankSum < -8.0'+'"'
        }
    }
    withName: GATK4_VARIANTFILTRATION_INDEL_FOR_VQ {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_indel_hq"}
        ext.args={
        '-filter-name '+'"'+'QD_filter'+'"'+' -filter '+'"'+'QD < 2.0'+'"'+
        ' -filter-name '+'"'+'QUAL_filter'+'"'+' -filter '+'"'+'QUAL < 30.0'+'"'+
        ' -filter-name '+'"'+'FS_filter'+'"'+' -filter '+'"'+'FS > 200.0'+'"'+
        ' -filter-name '+'"'+'ReadPosRankSum_filter'+'"'+' -filter '+'"'+'ReadPosRankSum < -20.0'+'"'
        }
    }
    withName: FILTER_PASS_VARIANT_FOR_VQ{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_forVQSR"}
    }
    withName: GATK4_INDEXFEATUREFILE_FOR_VQ{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
    }
    withName: GATK4_VARIANTRECALIBRATOR_INDEL{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_indel_vqsr"}
        ext.args={
        '-an DP -an QD -an FS -an SOR -an ReadPosRankSum -an MQRankSum '+
        '-mode INDEL '+
        '--max-gaussians 4 '
        }
        ext.resource1={"--resource:HQindel,known=true,training=true,truth=true,prior=12.0"}
        ext.resource2={"--resource:indel,known=true,training=false,truth=false,prior=2.0"}
    }
    withName: GATK4_APPLYVQSR_INDEL{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_indel_vqsr"}
        ext.args={"-mode INDEL --truth-sensitivity-filter-level 99.0"}
    }
    withName: GATK4_VARIANTRECALIBRATOR_SNP{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_indel_snp_vqsr"}
        ext.args={
        '-an DP -an QD -an FS -an SOR -an ReadPosRankSum -an MQRankSum '+
        '-mode SNP '+
        '-tranche 100.0 -tranche 99.9 -tranche 99.0 -tranche 95.0 -tranche 90.0 '
        }
        ext.resource1={"--resource:HQsnp,known=true,training=true,truth=true,prior=12.0"}
        ext.resource2={"--resource:snp,known=true,training=false,truth=false,prior=2.0"}
    }
    withName: GATK4_APPLYVQSR_SNP{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_indel_snp_vqsr"}
        ext.args={"-mode SNP --truth-sensitivity-filter-level 99.0"}
    }
    withName: GATK4_SELECTVARIANTS_SNP_VQ{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_after_vqsr_snp"}
        ext.args={"-select-type SNP"}
    }
    withName: GATK4_SELECTVARIANTS_INDEL_VQ{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/07_population_precalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
        ext.prefix={"${meta.id}_after_vqsr_indel"}
        ext.args={"-select-type INDEL"}
    }
    withName: FILTER_PASS_VARIANT_VQ{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/08_population_variants" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        publishDir = [
            path:{ "${params.outdir}/output/03_Variants_calling/08_population_variants" },
            mode: params.publish_dir_mode,
            pattern: "*.vcf.gz"
        ] 
        ext.prefix={"${meta.id}_afterVQSR_filtered"}
    }
    withName: GATK4_INDEXFEATUREFILE_VQ{
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/08_population_variants" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ] 
    }

}

