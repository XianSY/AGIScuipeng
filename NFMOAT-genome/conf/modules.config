/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: SAMPLESHEET_CHECK {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }

}

//data quality control
process {
    withName: FASTQC {
        publishDir = [
            path: { "${params.outdir}/01_QC/01_fastqc_raw" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: MULTIQC {
        publishDir = [
            path: { "${params.outdir}/01_QC/02_multiqc_raw" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: FASTP {
        ext.adapter_list = params.adapter_fasta ? "--adapter_fasta ${params.adapter_fasta}" : ""
        publishDir = [
            path: { "${params.outdir}/01_QC/03_fastp_trim" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: FASTQC_CLEAN {
        publishDir = [
            path: { "${params.outdir}/01_QC/04_fastqc_clean" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: MULTIQC_CLEAN {
        publishDir = [
            path: { "${params.outdir}/01_QC/05_multiqc_clean" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

//reads alignment

process {
    withName: MERGE_FASTQ {
        publishDir = [
            path: { "${params.outdir}/02_Alignment/01_merge_fastq" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: BWAMEM2_INDEX {
        publishDir = [
            path: { "${params.outdir}/02_Alignment/02_bwamem2_index" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: BWAMEM2_MEM {
        publishDir = [
            path: { "${params.outdir}/02_Alignment/03_bwamem2_mem_align" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        //ext.args = { "-R '@RG"+'\t'+"ID:${meta.id}_lc"+'\t'+"LB:lc"+'\t'+"PL:UNKNOWN"+'\t'+"SM:${meta.id}'" } 
        //it cause error when bwa Add this line into @PG line which cause splitingof@PG has two ID! use picard.
    }
    withName: PICARD_ADDORREPLACEREADGROUPS {
        publishDir = [
            path: { "${params.outdir}/02_Alignment/03_bwamem2_mem_align" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = {"--RGID ${meta.id}_lc --RGLB lc --RGPL UNKNOWN --RGPU NOPU --RGSM ${meta.id}"}
        ext.prefix ={"${meta.id}_addheader"}
    }
    withName: SAMTOOLS_INDEX_MAPPING {
        publishDir = [
            path: { "${params.outdir}/02_Alignment/03_bwamem2_mem_align" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: QUALIMAP_BAMQC {
        publishDir = [
            path: { "${params.outdir}/02_Alignment/04_align_qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

//variants calling

process {
    withName: SAMTOOLS_VIEW_FIL20 {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/01_samtools_fill_q20" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = {'-b -q 20 --output-fmt bam'}
        ext.args3 = {'_q20'}
    }
    withName: PICARD_SORTSAM {
        publishDir = [
            path: { "${params.outdir}/03_Variants_calling/02_picard_sort" },
            mode: params.publish_dir_mode,
