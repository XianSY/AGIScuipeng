//population structure
process {
    withName: STURCTURE_VCF_ADDID {
        publishDir = [
            path: { "${params.outdir}/05_Population_structure/01_variant_prepare" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: PLINK_INDEP {
        publishDir = [
            path: { "${params.outdir}/05_Population_structure/01_variant_prepare" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.window_size={"500"}
        ext.variant_count={"10"}
        ext.variance_inflation_factor={"0.05"}
        ext.prefix={"${meta.id}_indep_${task.ext.window_size}_${task.ext.variant_count}_${task.ext.variance_inflation_factor}"}
        ext.args={"--noweb --allow-extra-chr"}
    }
    withName: PLINK_EXTRACT {
        publishDir = [
            path: { "${params.outdir}/05_Population_structure/01_variant_prepare" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix={"${meta.id}"}
        ext.args={"--noweb --allow-extra-chr"}
    }
    withName: ADMIXTURE {
        publishDir = [
            path: { "${params.outdir}/05_Population_structure/02_structure_result" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

