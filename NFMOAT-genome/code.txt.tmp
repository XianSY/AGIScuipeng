  1721	    // Added soft-links to original fastqs for consistent naming in MultiQC
  1722	    // Use single ended for interleaved. Add --interleaved_in in config.
  1723	    if ( task.ext.args?.contains('--interleaved_in') ) {
  1724	        """
  1725	        [ ! -f  ${prefix}.fastq.gz ] && ln -sf $reads ${prefix}.fastq.gz
  1726	        echo "222222222222"
  1727	        fastp \\
  1728	            --stdout \\
  1729	            --in1 ${prefix}.fastq.gz \\
  1730	            --thread $task.cpus \\
  1731	            --json ${prefix}.fastp.json \\
