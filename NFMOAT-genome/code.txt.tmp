    40	include { INPUT_CHECK as INPUT_CHECK_BAM   } from '../subworkflows/local/input_check'
    41	/*
    42	~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    43	    RUN MAIN WORKFLOW
    44	~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    45	*/
    46	// Info required for completion email and summary
    47	    def multiqc_report = []
    48	workflow TEST {
    49	    main:
    50	    ch_versions = Channel.empty()
    51	    processList = params.processList.split(',')
    52	    start =  processList[0]
    53	    if (start == "A"){
    54	        INPUT_CHECK (
    55	        file(params.input)
    56	   	     )
    57	 	    ch_versions = ch_versions.mix(INPUT_CHECK.out.versions)
    58	        INPUT_CHECK.out.reads.view()	
    59	        FASTQS(
    60	                INPUT_CHECK.out.reads,
    61	                params.adapter_fasta,
    62	                params.save_trimmed_fail,
    63	                params.save_merged
    64	            )
    65	        ch_merge_fastq_files = FASTQS.out.fastqc_clean.map{
    66	        row -> def sampleParts = row[0].id.tokenize('_')
    67	            tuple(sampleParts[0],sampleParts[1],row[0].single_end,row[1][0], row[1][1])
    68	        }.groupTuple()
    69	        ch_versions     = ch_versions.mix((FASTQS.out.versions))
    70	        }
    71		if (start == "B"){
    72	        ch_merge_fastq_files = channel.fromPath(params.input).splitCsv().map{
    73	        row -> def sampleParts = row[0].tokenize('_')
    74	            tuple(sampleParts[0],sampleParts[1],row[1],row[2],row[3])
    75	        }.groupTuple()
    76	        ALIGN(
    77	        ch_merge_fastq_files
    78	        )
    79	        ch_bwamem2_mem_bam          = ALIGN.out.bwamem2_mem_bam
    80	        }else if('B' in processList){
    81	            ALIGN(
    82	                ch_merge_fastq_files
    83	            )           
    84	           ch_bwamem2_mem_bam          = ALIGN.out.bwamem2_mem_bam
    85	        }
    86	        if(start == "C"){
    87	        ch_bwamem2_men_bam = channel.fromPath(params.input)
    88	                             .splitCsv()
    89	                             .map{
    90	                                row -> def bam=[:]
    91	                                bam.id = row[0]
    92	                                tuple(bam,row[1])
    93	                             }
    94	        VARIANT(
    95	            ch_bwamem2_men_bam          ,
    96	        )
    97	        }else if('C' in processList){
    98	            VARIANT(
    99	                ch_bwamem2_mem_bam          
   100	            )
   101	        }
   102	        if (start == 'D'){
   103	            ch_gvcf_dbimport = channel.fromPath(params.input)
   104	                           .splitCsv()
   105	                           .collect()
   106	                           .toList()
   107	                           .view()
   108	        POPULATION(
   109	            ch_gvcf_dbimport                      ,
   110	        )
   111	        ch_vcf_tbi_structure_vcfaddid = POPULATION.out.ch_vcf_tbi_structure_vcfaddid
   112	        ch_vcf_tbi_pca_vcfaddid = POPULATION.out.ch_vcf_tbi_structure_vcfaddid
   113	        ANNOTATION(
   114	            POPULATION.out.ch_vcf_tbi_annotable
   115	        )
   116	        STRUCTURE(
   117	           ch_vcf_tbi_structure_vcfaddid
   118	        )
   119	        PCA(
   120	            ch_vcf_tbi_pca_vcfaddid,
   121	            STRUCTURE.out.ch_plink_indep_prunein
   122	            )
   123	        GWAS(
   124	            POPULATION.out.ch_vcf_tbi_pca_vcfaddid,
   125	            POPULATION.out.ch_groups_vcf_emmax_groupping,
   126	            ANNOTATION.out.ch_annoevf_emmax_anno
   127		        )
   128	        }else if ('D' in processList){
   129	            POPULATION(
   130	            VARIANT.out.ch_gvcf_dbimport          ,
   131	        )
   132	        ch_vcf_tbi_structure_vcfaddid = POPULATION.out.ch_vcf_tbi_structure_vcfaddid
   133	        ch_vcf_tbi_pca_vcfaddid = POPULATION.out.ch_vcf_tbi_structure_vcfaddid
   134	        ANNOTATION(
   135	            POPULATION.out.ch_vcf_tbi_annotable
   136	        )
   137	        STRUCTURE(
   138	           ch_vcf_tbi_structure_vcfaddid
   139	        )
   140		    PCA(
   141	            ch_vcf_tbi_pca_vcfaddid,
   142	 	    STRUCTURE.out.ch_plink_indep_prunein
   143	        )
   144	        GWAS(
   145	          POPULATION.out.ch_vcf_tbi_pca_vcfaddid,
   146	          POPULATION.out.ch_groups_vcf_emmax_groupping,
   147	          ANNOTATION.out.ch_annoevf_emmax_anno
   148		    )
   149	        }
   150	}
   151	/*
   152	~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   153	    COMPLETION EMAIL AND SUMMARY
   154	~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   155	*/
   156	workflow.onComplete {
   157	    if (params.email || params.email_on_fail) {
   158	        NfcoreTemplate.email(workflow, params, summary_params, projectDir, log)
   159	    }
   160	    NfcoreTemplate.summary(workflow, params, log)
   161	    if (params.hook_url) {
   162	        NfcoreTemplate.IM_notification(workflow, params, summary_params, projectDir, log)
   163	    }
   164	}
   165	/*
   166	~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   167	    THE END
   168	~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   169	*/
   170	//
   171	// Check input samplesheet and get read channels
   172	//
   173	include { SAMPLESHEET_CHECK } from '../../modules/local/samplesheet_check'
   174	workflow INPUT_CHECK {
   175	    take:
   176	    samplesheet // file: /path/to/samplesheet.csv
   177	    main:
   178	    SAMPLESHEET_CHECK ( samplesheet )
   179	        .csv
   180	        .splitCsv ( header:true, sep:',' )
   181	        .map { create_fastq_channel(it) }
   182	        .set { reads }
   183	    emit:
   184	    reads                                     // channel: [ val(meta), [ reads ] ]
   185	    versions = SAMPLESHEET_CHECK.out.versions // channel: [ versions.yml ]
   186	}
   187	// Function to get list of [ meta, [ fastq_1, fastq_2 ] ]
   188	def create_fastq_channel(LinkedHashMap row) {
   189	    // create meta map
   190	    def meta = [:]
   191	    meta.id         = row.sample
   192	    meta.single_end = row.single_end.toBoolean()
   193	    // add path(s) of the fastq file(s) to the meta map
   194	    def fastq_meta = []
   195	    if (!file(row.fastq_1).exists()) {
   196	        exit 1, "ERROR: Please check input samplesheet -> Read 1 FastQ file does not exist!\n${row.fastq_1}"
   197	    }
   198	    if (meta.single_end) {
   199	        fastq_meta = [ meta, [ file(row.fastq_1) ] ]
   200	    } else {
   201	        if (!file(row.fastq_2).exists()) {
   202	            exit 1, "ERROR: Please check input samplesheet -> Read 2 FastQ file does not exist!\n${row.fastq_2}"
   203	        }
   204	        fastq_meta = [ meta, [ file(row.fastq_1), file(row.fastq_2) ] ]
   205	    }
   206	    return fastq_meta
   207	}
   208	 include{ GUNZIP_FASTA as GUNZIP         }from '../../modules/nf-core/gunzip'
   209	 include{ GUNZIP_GTF as GUNZIP           }from '../../modules/nf-core/gunzip'
   210	 include{ GUNZIP_GTF as GUNZIP           }from '../../modules/nf-core/gunzip'
   211	 include{ GUNZIP_ADAPTER_FASTA as GUNZIP }from '../../modules/nf-core/gunzip'
   212	 include{ GUNZIP }from '../../modules/nf-core/gunzip/main'
   213	workflow PREPARE_GENOME {
   214	    take:
   215	    fasta                     //file : genome file .fa
   216	    gtf                       //file : gtf file .gtf
   217	    gff                       //file : gff file .gtf
   218	    adapter_fasta             //file : adapter file .fa
   219	    group                     //file : sample grouping file .csv
   220	    groupforassociate         //file : group grouping file .csv
   221	    phenotypes                //file : phenotype file .csv
   222	    main:
   223	    // ungzip the fasta.gz file
   224	    if (fasta.endsWith(".gz")) {
   225	        // ungip fasta.gz file 
   226	        ch_fasta = GUNZIP_FASTA([[:],fasta]).gunzip.map{it[1]}
   227	    }else {
   228	        ch_fasta = Channel.value(file(fasta))
   229	    }
   230	    // ungzip gtf.gz || gff.gz file 
   231	    if ( gtf || gff ) {
   232	        if (gtf) {
   233	            if ( gtf.endsWith(".gz")){
   234	                ch_gtf = GUNZIP_GTF([[:],gtf]).gunzip.map{it[1]}
   235	            }
   236	            else{
   237	                ch_gtf = Channel.value(file(gtf))
   238	            }
   239	        }
   240	        else if (gff) {
   241	            if ( gff.endsWith(".gz")){
   242	                ch_gff = GUNZIP_GTF([[:],gff]).gunzip.map{it[1]}
   243	            }
   244	            else{
   245	                ch_gff = Channel.value(file(gff))
   246	            }
   247	            ch_gtf = GFFREAD ( ch_gff ).gtf
   248	        }
   249	    }
   250	    // ungzip adapter_fasta.gz file
   251	    if (adapter_fasta){
   252	        if ( adapter_fasta.endsWith(".gz") ){
   253	        ch_adapter_fasta = GUNZIP_ADAPTER_FASTA([[:],adapter_fasta]).gunzip.map{it[1]}
   254	    }else{
   255	        ch_adapter_fasta = Channel.value(file(adapter_fasta))
   256	    }
   257	    }
   258	}include { BWAMEM2_INDEX                 } from '../../../modules/nf-core/bwamem2/index/main'
   259	include { BWAMEM2_MEM                   } from '../../../modules/nf-core/bwamem2/mem/main'  
   260	include { MERGE_FASTQ                   } from '../../../modules/local/merge_fastq'
   261	workflow ALIGN {
   262	    take:
   263	    ch_fastqc_clean
   264	    main:
   265	    ch_merge_fastq_files = ch_fastqc_clean
   266	        //ch_merge_fastq_files.view()i
   267	    MERGE_FASTQ (
   268	        ch_merge_fastq_files
   269	    )
   270	    ch_map_fastq = MERGE_FASTQ.out.reads
   271	    //ch_map_fastq.view()
   272	    //def refname = file(fastaPath).baseName
   273	    def bwaidx_meta='fasta'
   274	    ch_fasta_genome_withmeta=tuple(bwaidx_meta, file(params.fasta))
   275	    ch_fasta_genome_withoutmeta=file(params.fasta)
   276	    BWAMEM2_INDEX (
   277	        ch_fasta_genome_withmeta
   278	    )
   279	    //ch_map_fastq.view()
   280	    ch_tomap_fastq=ch_map_fastq.map{
   281	        row -> 
   282	            def sampleid = [:]
   283	            sampleid.id=row[0]
   284	            [sampleid,row[1]]
   285	    }
   286	    //ch_tomap_fastq.view()
   287	    BWAMEM2_MEM (
   288	        ch_tomap_fastq,
   289	        BWAMEM2_INDEX.out.index,
   290	        true
   291	    )
   292	    emit:
   293	    bwamem2_mem_bam          = BWAMEM2_MEM.out.bam
   294	}
   295	include { ANNO_GFF3TOGENEPRED           } from '../../../modules/local/anno_gff3togenepred'
   296	include { ANNO_RETRIEVE_SEQ             } from '../../../modules/local/anno_retrieve_seq_from_fasta'
   297	include { ANNO_CONVERT2ANNOVAR          } from '../../../modules/local/anno_convert2annovar'
   298	include { ANNO_TABLE                    } from '../../../modules/local/anno_table_annovar'
   299	workflow ANNOTATION {
   300	    take:
   301	    ch_vcf_tbi_annotable
   302	    main:
   303	    ch_anno_gff_meta=['id':'ANNO']
   304	    ch_gff_gff3togenepred_withmeta=tuple(ch_anno_gff_meta, file(params.gff))
   305	    ch_gff_gff3togenepred_withoutmeta=file(params.gff)
   306	    ANNO_GFF3TOGENEPRED(
   307	        ch_gff_gff3togenepred_withmeta
   308	    )
   309	    ch_fasta_gff3togenepred_withmeta=tuple(ch_anno_gff_meta, file(params.fasta))
   310	    ch_fasta_genepred_gff3togenepred_withmeta=ANNO_GFF3TOGENEPRED.out.genep.map{
   311	        it-> tuple(it[0],it[1],ch_fasta_gff3togenepred_withmeta[1])}
   312	    ANNO_RETRIEVE_SEQ(
   313	        ch_fasta_genepred_gff3togenepred_withmeta
   314	    )
   315	    ch_vcf_tbi_annotable=ch_vcf_tbi_annotable
   316	    ANNO_CONVERT2ANNOVAR(
   317	        ch_vcf_tbi_annotable
   318	    )
   319	    ch_vcf_tbi_fa_fa2_gff_list_annotable=ch_vcf_tbi_annotable.map{
   320	        it-> tuple(it[0],it[1],it[2],ch_fasta_gff3togenepred_withmeta[1])}.join(
   321	                                    ANNO_RETRIEVE_SEQ.out.fa).map{
   322	        it-> tuple(it[0],it[1],it[2],it[3],it[4],ch_gff_gff3togenepred_withmeta[1])}.join(
   323	                                     ANNO_GFF3TOGENEPRED.out.genep).join(
   324	                                        ANNO_CONVERT2ANNOVAR.out.anno
   325	                                     )
   326	    ANNO_TABLE(
   327	        ch_vcf_tbi_fa_fa2_gff_list_annotable
   328	    )
   329	   emit:
   330	   ch_annoevf_emmax_anno=ANNO_TABLE.out.annoevf.map{it->it[1]}
   331	}
   332	/*
   333	~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   334	    PRINT PARAMS SUMMARY
   335	~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   336	*/
   337	include { paramsSummaryLog; paramsSummaryMap } from 'plugin/nf-validation'
   338	def logo = NfcoreTemplate.logo(workflow, params.monochrome_logs)
   339	def citation = '\n' + WorkflowMain.citation(workflow) + '\n'
   340	def summary_params = paramsSummaryMap(workflow)
   341	// Print parameter summary log to screen
   342	log.info logo + paramsSummaryLog(workflow) + citation
   343	WorkflowTest.initialise(params, log)
   344	/*
   345	~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   346	    CONFIG FILES
   347	~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   348	*/
   349	ch_multiqc_config          = Channel.fromPath("$projectDir/assets/multiqc_config.yml", checkIfExists: true)
   350	ch_multiqc_custom_config   = params.multiqc_config ? Channel.fromPath( params.multiqc_config, checkIfExists: true ) : Channel.empty()
   351	ch_multiqc_logo            = params.multiqc_logo   ? Channel.fromPath( params.multiqc_logo, checkIfExists: true ) : Channel.empty()
   352	ch_multiqc_custom_methods_description = params.multiqc_methods_description ? file(params.multiqc_methods_description, checkIfExists: true) : file("$projectDir/assets/methods_description_template.yml", checkIfExists: true)
   353	include { FASTQC                        } from '../../../modules/nf-core/fastqc/main'
   354	include { MULTIQC                       } from '../../../modules/nf-core/multiqc/main'
   355	include { FASTQC as FASTQC_CLEAN        } from '../../../modules/nf-core/fastqc/main'
   356	include { MULTIQC as MULTIQC_CLEAN      } from '../../../modules/nf-core/multiqc/main'
   357	include { FASTP                         } from '../../../modules/nf-core/fastp/main'  
   358	include { CUSTOM_DUMPSOFTWAREVERSIONS   } from '../../../modules/nf-core/custom/dumpsoftwareversions/main'
   359	workflow FASTQS{
   360	    take:
   361	    reads
   362	    adapter_fasta
   363	    save_trimmed_fail
   364	    save_merged
   365	    main:
   366	    ch_versions = Channel.empty()
   367	     //
   368	    // MODULE: Run FastQC
   369	    //
   370	    FASTQC (
   371	        reads
   372	    )
   373	    ch_versions = ch_versions.mix(FASTQC.out.versions.first())
   374	    CUSTOM_DUMPSOFTWAREVERSIONS (
   375	        ch_versions.unique().collectFile(name: 'collated_versions.yml')
   376	    )
   377	    //
   378	    // MODULE: MultiQC
   379	    //
   380	    //WorkflowTest.groovy
   381	    workflow_summary    = WorkflowTest.paramsSummaryMultiqc(workflow, summary_params)
   382	    ch_workflow_summary = Channel.value(workflow_summary)
   383	    methods_description    = WorkflowTest.methodsDescriptionText(workflow, ch_multiqc_custom_methods_description, params)
   384	    ch_methods_description = Channel.value(methods_description)
   385	    ch_multiqc_files = Channel.empty()
   386	    ch_multiqc_files = ch_multiqc_files.mix(ch_workflow_summary.collectFile(name: 'workflow_summary_mqc.yaml'))
   387	    ch_multiqc_files = ch_multiqc_files.mix(ch_methods_description.collectFile(name: 'methods_description_mqc.yaml'))
   388	    ch_multiqc_files = ch_multiqc_files.mix(CUSTOM_DUMPSOFTWAREVERSIONS.out.mqc_yml.collect())
   389	    ch_multiqc_files = ch_multiqc_files.mix(FASTQC.out.zip.collect{it[1]}.ifEmpty([]))
   390	    MULTIQC (
   391	        ch_multiqc_files.collect(),
   392	        ch_multiqc_config.toList(),
   393	        ch_multiqc_custom_config.toList(),
   394	        ch_multiqc_logo.toList()
   395	    )
   396	    FASTP (
   397	        reads,
   398	        adapter_fasta,
   399	        save_trimmed_fail,
   400	        save_merged
   401	    )
   402	    //    ch_versions = ch_versions.mix(FASTP.out.versions.first())
   403	    ch_fastqc_clean = Channel.empty()
   404	    ch_fastqc_clean = FASTP.out.reads
   405	    FASTQC_CLEAN (
   406	        ch_fastqc_clean
   407	    )
   408	    ch_multiqc_files = Channel.empty()
   409	    ch_multiqc_files = ch_multiqc_files.mix(ch_workflow_summary.collectFile(name: 'workflow_summary_mqc.yaml'))
   410	    ch_multiqc_files = ch_multiqc_files.mix(ch_methods_description.collectFile(name: 'methods_description_mqc.yaml'))
   411	    ch_multiqc_files = ch_multiqc_files.mix(CUSTOM_DUMPSOFTWAREVERSIONS.out.mqc_yml.collect())
   412	    ch_multiqc_files = ch_multiqc_files.mix(FASTQC_CLEAN.out.zip.collect{it[1]}.ifEmpty([]))
   413	    MULTIQC_CLEAN (
   414	        ch_multiqc_files.collect(),
   415	        ch_multiqc_config.toList(),
   416	        ch_multiqc_custom_config.toList(),
   417	        ch_multiqc_logo.toList()
   418	    )
   419	    emit:
   420	    fastqc_clean   =  ch_fastqc_clean
   421	    versions       =  ch_versions
   422	}
   423	include { EMMAX_VCF_GROUPPING                                      } from '../../../modules/local/gwas_vcfgroup'
   424	include { STURCTURE_VCF_ADDID as EMMAX_VCF_ADDID                   } from '../../../modules/local/structure_vcfaddid'
   425	include { PLINK_INDEP as EMMAX_PLINK_INDEP                         } from '../../../modules/nf-core/plink/indep/main'
   426	include { PLINK_EXTRACT as EMMAX_PLINK_EXTRACT                     } from '../../../modules/nf-core/plink/extract/main'
   427	include { ADMIXTURE as EMMAX_ADMIXTURE                             } from '../../../modules/nf-core/admixture/main'
   428	include { GWAS_EMMAX_PLINK_FMAT                                    } from '../../../modules/local/gwas_emmax_plink_fmat'
   429	include { GWAS_EMMAX_COV                                           } from '../../../modules/local/gwas_emmax_cov'
   430	include { GWAS_EMMAX_KINSHIP                                       } from '../../../modules/local/gwas_emmax_kin'
   431	include { GWAS_EMMAX_ASSOCIATE                                     } from '../../../modules/local/gwas_emmax_assoc'
   432	include { GWAS_EMMAX_CMPLOT                                        } from '../../../modules/local/gwas_emmax_cmplot'
   433	include { GWAS_EMMAX_ANNOTATION                                    } from '../../../modules/local/gwas_emmax_annotation'
   434	include { STRUCTURE_PLOT                                           } from '../../../modules/local/structure_plot'
   435	workflow GWAS {
   436	    take:
   437	    ch_vcf_tbi_annotable
   438	    ch_vcf_tbi_structure_vcfaddid
   439	    ch_annoevf_emmax_anno
   440	    main:
   441	    if(params.group && params.groupforassociate){
   442	        //println("exist")
   443	        ch_groupa=Channel.fromPath(params.groupforassociate).splitCsv(header:true).map{it -> tuple([group:it['group']],[groupassoc:it['groupassoc']])}.view()
   444	        ch_group=Channel.fromPath(params.group).splitCsv(header:true).map{it -> tuple([group:it['group']],[sample:it['sample']])}.view()
   445	        ch_group_info=ch_groupa.combine(ch_group,by:0)
   446	        //ch_group_info.view()
   447	        ch_group_split=ch_group_info.map{it-> if(it[1].groupassoc=="1"){tuple(['id':it[0].group],it[2].sample)}}.groupTuple()
   448	        //ch_group_split.view()
   449	        ch_all_split=ch_group_info.map{it -> tuple(['id':'popu_snp'],it[2].sample)}.groupTuple()
   450	        //ch_all_split.view()
   451	        ch_groups=ch_all_split.concat(ch_group_split)
   452	        //ch_groups.view()
   453	        ch_vcf_tbi_pca_vcfaddid=ch_vcf_tbi_annotable
   454	        //ch_vcf_tbi_pca_vcfaddid.view()
   455	        ch_groups_vcf_emmax_groupping=ch_groups.combine(ch_vcf_tbi_pca_vcfaddid)
   456	        //ch_groups_vcf_emmax_groupping.view()
   457	    }else{
   458	        //println("not exist")
   459	        ch_groups_vcf_emmax_groupping=ch_vcf_tbi_structure_vcfaddid
   460	    }
   461	    //ch_groups_vcf_emmax_groupping.view()
   462	    EMMAX_VCF_GROUPPING(
   463	        ch_groups_vcf_emmax_groupping
   464	    )
   465	    //EMMAX_VCF_GROUPPING.out.vcf.view()
   466	    EMMAX_VCF_ADDID(
   467	        EMMAX_VCF_GROUPPING.out.vcf
   468	    )
   469	    EMMAX_PLINK_INDEP(
   470	        EMMAX_VCF_ADDID.out.vcf
   471	    )
   472	    ch_vcf_tbi_prunein_emmax_plink_extract=EMMAX_VCF_ADDID.out.vcf.join(EMMAX_PLINK_INDEP.out.prunein)
   473	    EMMAX_PLINK_EXTRACT(
   474	        ch_vcf_tbi_prunein_emmax_plink_extract
   475	    )
   476	    ch_bed_bim_fam_EMMAX_k_admixture=EMMAX_PLINK_EXTRACT.out.bed.join(EMMAX_PLINK_EXTRACT.out.bim).join(EMMAX_PLINK_EXTRACT.out.fam).combine(Channel.from(2,3,4,5,6,7,8,9,10)).map{
   477	        it -> tuple(['id':"popu_snp_${it[4]}","group":"${it[0].id}"],it[1],it[2],it[3],it[4])
   478	    }
   479	    //ch_bed_bim_fam_EMMAX_k_admixture.view()
   480	    EMMAX_ADMIXTURE(
   481	        ch_bed_bim_fam_EMMAX_k_admixture
   482	    )
   483	    ch_vcf_tbi_chrnum_ctgnum_emmax_fmat=EMMAX_VCF_ADDID.out.vcf.join(EMMAX_VCF_ADDID.out.ctgnum)
   484	    //ch_vcf_tbi_chrnum_ctgnum_emmax_fmat.view()
   485	    GWAS_EMMAX_PLINK_FMAT(
   486	        ch_vcf_tbi_chrnum_ctgnum_emmax_fmat
   487	    )
   488	    ch_qfile_tpedfam_emmax_cov=EMMAX_ADMIXTURE.out.ancestry_fractions.join(EMMAX_ADMIXTURE.out.cvlog).map{
   489	              it-> tuple(['id':"${it[0].group}"],it[1],it[2])}.groupTuple().join(
   490	                GWAS_EMMAX_PLINK_FMAT.out.emmaxfile.map{it-> tuple(['id':"${it[0].id}"],it[2])})
   491	    GWAS_EMMAX_COV(
   492	        ch_qfile_tpedfam_emmax_cov
   493	    )
   494	    STRUCTURE_PLOT(
   495	        GWAS_EMMAX_COV.out.cverr
   496	    )
   497	    ch_tped_tfam_emmax_kin=GWAS_EMMAX_PLINK_FMAT.out.emmaxfile.map{it-> tuple(['id':"${it[0].id}"],it[1],it[2],it[3],it[4])}
   498	    GWAS_EMMAX_KINSHIP(
   499	        ch_tped_tfam_emmax_kin
   500	    )
   501	    ch_emmax_assoc=GWAS_EMMAX_PLINK_FMAT.out.emmaxfile.map{it-> tuple(['id':"${it[0].id}"],it[1],it[2],it[3],it[4])}.
   502	        join(GWAS_EMMAX_KINSHIP.out.kin).
   503	        join(GWAS_EMMAX_COV.out.cov).combine(Channel.fromPath(params.phenotypes)).
   504	        combine(Channel.fromPath(params.phenotypes).
   505	        splitCsv().first().flatMap().filter{it != 'sample'}.
   506	        merge(Channel.from(1..10000)).combine(Channel.from('K','KQ')))
   507	   ch_emmax_assoc.view()
   508	    GWAS_EMMAX_ASSOCIATE(
   509	        ch_emmax_assoc
   510	    )
   511	    GWAS_EMMAX_CMPLOT(
   512	        GWAS_EMMAX_ASSOCIATE.out.assoc
   513	    )
   514	    ch_annoevf_emmax_anno=ch_annoevf_emmax_anno
   515	    ch_signif_annoevf_emmax_anno=GWAS_EMMAX_CMPLOT.out.signif.combine(ch_annoevf_emmax_anno)
   516	    //ch_signif_annoevf_emmax_anno.view()
   517	    GWAS_EMMAX_ANNOTATION(
   518	        ch_signif_annoevf_emmax_anno
   519	    )
   520	}
   521	include { PCA_VCF_ADDID                 } from '../../../modules/local/pca_vcfaddid'
   522	include { VCFTOOLS_PLINK                } from '../../../modules/local/vcftools_plink'
   523	include { PLINK_MAKEBED                 } from '../../../modules/local/plink_makebed'
   524	include { GCTA_MAKEGRM                  } from '../../../modules/local/gcta_makegrm'
   525	include { GCTA_PCA                      } from '../../../modules/local/gcta_pca'
   526	include { GCTA_PCA_PLOT                 } from '../../../modules/local/gcta_pca_plot'
   527	workflow PCA {
   528	    take:
   529	    ch_vcf_tbi_pca_vcfaddid
   530	    ch_plink_indep_prunein
   531	    main:
   532	    PCA_VCF_ADDID(
   533	        ch_vcf_tbi_pca_vcfaddid
   534	    )
   535	    ch_vcftools_plink=PCA_VCF_ADDID.out.vcf.join(ch_plink_indep_prunein)
   536	    VCFTOOLS_PLINK(
   537	        ch_vcftools_plink
   538	    )
   539	    PLINK_MAKEBED(
   540	        VCFTOOLS_PLINK.out.plink
   541	    )
   542	    ch_bed_bim_fam_gcta_makegrm=VCFTOOLS_PLINK.out.plink.join(PLINK_MAKEBED.out.bed)
   543	    GCTA_MAKEGRM(
   544	        ch_bed_bim_fam_gcta_makegrm
   545	    )
   546	    GCTA_PCA(
   547	        GCTA_MAKEGRM.out.grm
   548	    )
   549	    ch_eigenvec = GCTA_PCA.out.vec.map{
   550	        row -> tuple(row[0],row[2])
   551	    }.view()
   552	    GCTA_PCA_PLOT(
   553	        ch_eigenvec
   554	    )
   555	}
   556	include { GET_CHROMSOME_LST                                               } from '../../../modules/local/get_chromsomelst'
   557	include { GATK4_GENOMICSDBIMPORT                                          } from '../../../modules/nf-core/gatk4/genomicsdbimport/main'
   558	include { GATK4_GENOTYPEGVCFS                                             } from '../../../modules/nf-core/gatk4/genotypegvcfs/main'
   559	include { GATK4_GATHERVCFS                                                } from '../../../modules/local/gatk4_gathervcfs'
   560	include { GATK4_SELECTVARIANTS as GATK4_SELECTVARIANTS_SNP_HQ             } from '../../../modules/nf-core/gatk4/selectvariants/main'
   561	include { GATK4_SELECTVARIANTS as GATK4_SELECTVARIANTS_INDEL_HQ           } from '../../../modules/nf-core/gatk4/selectvariants/main'
   562	include { GATK4_VARIANTFILTRATION as GATK4_VARIANTFILTRATION_SNP_FOR_VQ   } from '../../../modules/nf-core/gatk4/variantfiltration/main'
   563	include { GATK4_VARIANTFILTRATION as GATK4_VARIANTFILTRATION_INDEL_FOR_VQ } from '../../../modules/nf-core/gatk4/variantfiltration/main'
   564	include { FILTER_PASS_VARIANT as FILTER_PASS_VARIANT_FOR_VQ               } from '../../../modules/local/filter_pass_variant'
   565	include { GATK4_INDEXFEATUREFILE as GATK4_INDEXFEATUREFILE_FOR_VQ         } from '../../../modules/nf-core/gatk4/indexfeaturefile/main'
   566	include { GATK4_VARIANTRECALIBRATOR as GATK4_VARIANTRECALIBRATOR_SNP      } from '../../../modules/nf-core/gatk4/variantrecalibrator/main'
   567	include { GATK4_APPLYVQSR as GATK4_APPLYVQSR_SNP                          } from '../../../modules/nf-core/gatk4/applyvqsr/main'
   568	include { GATK4_VARIANTRECALIBRATOR as GATK4_VARIANTRECALIBRATOR_INDEL    } from '../../../modules/nf-core/gatk4/variantrecalibrator/main'
   569	include { GATK4_APPLYVQSR as GATK4_APPLYVQSR_INDEL                        } from '../../../modules/nf-core/gatk4/applyvqsr/main'
   570	include { GATK4_SELECTVARIANTS as GATK4_SELECTVARIANTS_SNP_VQ             } from '../../../modules/nf-core/gatk4/selectvariants/main'
   571	include { GATK4_SELECTVARIANTS as GATK4_SELECTVARIANTS_INDEL_VQ           } from '../../../modules/nf-core/gatk4/selectvariants/main'
   572	include { FILTER_PASS_VARIANT as FILTER_PASS_VARIANT_VQ                   } from '../../../modules/local/filter_pass_variant'
   573	include { GATK4_INDEXFEATUREFILE as GATK4_INDEXFEATUREFILE_VQ             } from '../../../modules/nf-core/gatk4/indexfeaturefile/main'
   574	include { GATK4_CREATESEQUENCEDICTIONARY                           } from '../../../modules/nf-core/gatk4/createsequencedictionary/main'
   575	include { SAMTOOLS_FAIDX                                           } from '../../../modules/nf-core/samtools/faidx/main'
   576	include { GATK4_INDEXFEATUREFILE_GCVF                                     } from '../../../modules/nf-core/gatk4/indexgcvffile/main'
   577	workflow POPULATION{
   578	    take:
   579	    ch_gvcf_dbimport
   580	    //ch_tbi_dbimport
   581	    main:
   582	    def bwaidx_meta='fasta'
   583	    ch_fasta_genome_withmeta=tuple(bwaidx_meta, file(params.fasta))
   584	    ch_fasta_genome_withoutmeta=file(params.fasta)
   585	    SAMTOOLS_FAIDX(
   586	            ch_fasta_genome_withmeta
   587	        )
   588	    ch_fai_genome_withoutmeta= SAMTOOLS_FAIDX.out.fai.collect().flatten().toList().map{it -> it[1]} 
   589	    ch_samtools_faidx_fai    = SAMTOOLS_FAIDX.out.fai
   590	    GATK4_CREATESEQUENCEDICTIONARY(
   591	            ch_fasta_genome_withmeta
   592	        )
   593	    ch_dict_genome_withoutmeta=GATK4_CREATESEQUENCEDICTIONARY.out.dict.collect().flatten().toList().map{it -> it[1]}
   594	    ch_gatk4_createsequencedictionary_dict = GATK4_CREATESEQUENCEDICTIONARY.out.dict
   595	    GET_CHROMSOME_LST(
   596	        ch_fasta_genome_withoutmeta
   597	    )
   598	    ch_gvcf_indexfeaturefile = ch_gvcf_dbimport
   599	                           .flatten()
   600	    GATK4_INDEXFEATUREFILE_GCVF(
   601	        ch_gvcf_indexfeaturefile
   602	    )
   603	    //ch_gvcf_dbimport.view() 
   604	    ch_tbi_dbimport = GATK4_INDEXFEATUREFILE_GCVF.out.tbi.collect().toList()
   605	    // ch_tbi_dbimport.view()   
   606	    //ch_gvcf_dbimport=GATK4_HAPLOTYPECALLER_GVCF.out.vcf.map{it -> it[1]}.collect{it -> "--variant ${it}"}.map{it-> it.join(' ')}
   607	    //ch_gvcf_dbimport=GATK4_HAPLOTYPECALLER_GVCF.out.vcf.map{it -> it[1]}.collect().toList()
   608	    //ch_tbi_dbimport=GATK4_HAPLOTYPECALLER_GVCF.out.tbi.map{it -> it[1]}.collect().toList()
   609	    ch_gvcf_tbi_interval_wspace_dbimport=Channel.from(["id":"population"]).combine(
   610	        ch_gvcf_dbimport).combine(ch_tbi_dbimport).combine(GET_CHROMSOME_LST.out.lst.map{it->it[0]}).combine(
   611	        Channel.from(false)).combine(Channel.from(file("NOFILE")))
   612	    // ch_gvcf_tbi_interval_wspace_dbimport.view()
   613	    GATK4_GENOMICSDBIMPORT(
   614	        ch_gvcf_tbi_interval_wspace_dbimport,
   615	        false,
   616	        false,
   617	        false
   618	    )
   619	    ch_chrom_genotypegvcfs=GET_CHROMSOME_LST.out.lst.map{it->it[1]}.splitText(by:1).map{it->it.split("\n")[0]}
   620	    ch_ctg_genotypegvcfs=GET_CHROMSOME_LST.out.lst.map{it->it[2]}
   621	    ch_chrom_ctg_genotypegvcfs=ch_chrom_genotypegvcfs.map{file("NOFILE")}
   622	    ch_chrom_ctg_genotypegvcfs=ch_chrom_ctg_genotypegvcfs.concat(ch_ctg_genotypegvcfs)
   623	    ch_ctgline_genotypegvcfs=Channel.from(false)
   624	    ch_chrom_genotypegvcfs=ch_chrom_genotypegvcfs.concat(ch_ctgline_genotypegvcfs)
   625	    ch_meta_id_genotypegvcfs=ch_chrom_genotypegvcfs.map{it->
   626	        it==false ? tuple(["id":"ctg"],it) : tuple(["id":it],it)
   627	    }
   628	    ch_interval_genotypegvcfs=ch_meta_id_genotypegvcfs.merge(ch_chrom_ctg_genotypegvcfs)
   629	    ch_gvcfdb_genotypegvcfs=GATK4_GENOMICSDBIMPORT.out.genomicsdb.map{itdb->itdb[1]}
   630	    ch_gvcf_fai_interval_genotypegvcfs=ch_interval_genotypegvcfs.combine(ch_gvcf_dbimport).combine(ch_tbi_dbimport).combine(ch_gvcfdb_genotypegvcfs).map{
   631	        it-> tuple(it[0],it[5],it[4],it[1],it[2])
   632	    }
   633	    //GATK4_GENOMICSDBIMPORT.out.genomicsdb.map{itdb->itdb[1]}.view()
   634	    GATK4_GENOTYPEGVCFS(
   635	        ch_gvcf_fai_interval_genotypegvcfs,
   636	        ch_fasta_genome_withoutmeta,
   637	        ch_fai_genome_withoutmeta,
   638	        ch_dict_genome_withoutmeta
   639	        //file("NOFILE"),
   640	        //file("NOFILE")
   641	    )
   642	    ch_vcf_gathervcfs=ch_interval_genotypegvcfs.merge(
   643	        Channel.from(1..100000)).join(
   644	            GATK4_GENOTYPEGVCFS.out.vcf).toSortedList{
   645	                 a, b -> a[3] <=> b[3] 
   646	            }.flatten().buffer(size:5).map{it->it[4]}.flatten().collect().map{it-> tuple(['id':'population'],it)}
   647	    ch_tbi_gathervcfs=ch_interval_genotypegvcfs.merge(
   648	        Channel.from(1..100000)).join(
   649	            GATK4_GENOTYPEGVCFS.out.tbi).toSortedList{
   650	                 a, b -> a[3] <=> b[3] 
   651	            }.flatten().buffer(size:5).map{it->it[4]}.flatten().collect().map{it-> tuple(['id':'population'],it)}
   652	    ch_vcf_tbi_gathervcfs=ch_vcf_gathervcfs.join(ch_tbi_gathervcfs)
   653	    ch_vcf_gathervcfs.view()
   654	    GATK4_GATHERVCFS(
   655	        ch_vcf_tbi_gathervcfs
   656	    )
   657	    ch_vcf_tbi_selectvariants_snp_hq=GATK4_GATHERVCFS.out.vcf.join(GATK4_GATHERVCFS.out.tbi)
   658	    ch_vcf_tbi_intervals_selectvariants_snp_hq=ch_vcf_tbi_selectvariants_snp_hq.map{
   659	            it -> tuple(it[0],it[1],it[2],file("NOFILE"))
   660	    }
   661	    GATK4_SELECTVARIANTS_SNP_HQ(
   662	        ch_vcf_tbi_intervals_selectvariants_snp_hq
   663	    )
   664	    GATK4_SELECTVARIANTS_INDEL_HQ(
   665	        ch_vcf_tbi_intervals_selectvariants_snp_hq
   666	    )
   667	    ch_vcf_tbi_variantfil_snp_forvq=GATK4_SELECTVARIANTS_SNP_HQ.out.vcf.join(GATK4_SELECTVARIANTS_SNP_HQ.out.tbi)
   668	    GATK4_VARIANTFILTRATION_SNP_FOR_VQ(
   669	        ch_vcf_tbi_variantfil_snp_forvq,
   670	        ch_fasta_genome_withmeta,
   671	        ch_samtools_faidx_fai,
   672	        ch_gatk4_createsequencedictionary_dict
   673	    )
   674	    ch_vcf_tbi_variantfil_indel_forvq=GATK4_SELECTVARIANTS_INDEL_HQ.out.vcf.join(GATK4_SELECTVARIANTS_INDEL_HQ.out.tbi)
   675	    GATK4_VARIANTFILTRATION_INDEL_FOR_VQ(
   676	        ch_vcf_tbi_variantfil_indel_forvq,
   677	        ch_fasta_genome_withmeta,
   678	        ch_samtools_faidx_fai,
   679		ch_gatk4_createsequencedictionary_dict   
   680	 )
   681	    ch_vcf_tbi_type_filpass_for_vq=GATK4_VARIANTFILTRATION_SNP_FOR_VQ.out.vcf.join(GATK4_VARIANTFILTRATION_SNP_FOR_VQ.out.tbi).map{
   682	        it-> tuple(['id':'snp'],it[1],it[2])
   683	    }.concat(GATK4_VARIANTFILTRATION_INDEL_FOR_VQ.out.vcf.join(GATK4_VARIANTFILTRATION_INDEL_FOR_VQ.out.tbi).map{
   684	        it-> tuple(['id':'indel'],it[1],it[2])
   685	    })
   686	    FILTER_PASS_VARIANT_FOR_VQ(
   687	        ch_vcf_tbi_type_filpass_for_vq
   688	    )
   689	    FILTER_PASS_VARIANT_FOR_VQ.out.vcf.view()
   690	    GATK4_INDEXFEATUREFILE_FOR_VQ(
   691	        FILTER_PASS_VARIANT_FOR_VQ.out.vcf
   692	    )
   693	    ch_resource_vcf_vqsr_indel=FILTER_PASS_VARIANT_FOR_VQ.out.vcf.map{it->if(it[0].id=="indel"){it[1]}}.combine(GATK4_VARIANTFILTRATION_INDEL_FOR_VQ.out.vcf.map{it->it[1]})
   694	    ch_resource_tbi_vqsr_indel=GATK4_INDEXFEATUREFILE_FOR_VQ.out.index.map{it->if(it[0].id=="indel"){it[1]}}.combine(GATK4_VARIANTFILTRATION_INDEL_FOR_VQ.out.tbi.map{it->it[1]})
   695	    ch_vcf_tbi_vqsr_indel=GATK4_GATHERVCFS.out.vcf.join(GATK4_GATHERVCFS.out.tbi).map{it->tuple(['id':'indel'],it[1],it[2])}
   696	   // ch_resource_tbi_vqsr_indel.view()
   697	    GATK4_VARIANTRECALIBRATOR_INDEL(
   698	        ch_vcf_tbi_vqsr_indel,
   699	        ch_resource_vcf_vqsr_indel,
   700	        ch_resource_tbi_vqsr_indel,
   701	        ch_fasta_genome_withoutmeta,
   702	        ch_fai_genome_withoutmeta,
   703	        ch_dict_genome_withoutmeta
   704	    )
   705	    ch_applyvqsr_indel=ch_vcf_tbi_vqsr_indel.join(
   706	        GATK4_VARIANTRECALIBRATOR_INDEL.out.recal).join(
   707	        GATK4_VARIANTRECALIBRATOR_INDEL.out.idx).join(
   708	        GATK4_VARIANTRECALIBRATOR_INDEL.out.tranches)
   709	    GATK4_APPLYVQSR_INDEL(
   710	        ch_applyvqsr_indel,
   711	        ch_fasta_genome_withoutmeta,
   712	        ch_fai_genome_withoutmeta,
   713	        ch_dict_genome_withoutmeta
   714	    )
   715	    ch_resource_vcf_vqsr_snp=FILTER_PASS_VARIANT_FOR_VQ.out.vcf.map{it->if(it[0].id=="snp"){it[1]}}.combine(GATK4_VARIANTFILTRATION_SNP_FOR_VQ.out.vcf.map{it->it[1]})
   716	    ch_resource_tbi_vqsr_snp=GATK4_INDEXFEATUREFILE_FOR_VQ.out.index.map{it->if(it[0].id=="snp"){it[1]}}.combine(GATK4_VARIANTFILTRATION_SNP_FOR_VQ.out.tbi.map{it->it[1]})    
   717	    ch_vcf_tbi_vqsr_indel_snp=GATK4_APPLYVQSR_INDEL.out.vcf.join(GATK4_APPLYVQSR_INDEL.out.tbi).map{it->tuple(['id':'indel_snp'],it[1],it[2])}
   718	    GATK4_VARIANTRECALIBRATOR_SNP(
   719	        ch_vcf_tbi_vqsr_indel_snp,
   720	        ch_resource_vcf_vqsr_snp,
   721	        ch_resource_tbi_vqsr_snp,
   722	        ch_fasta_genome_withoutmeta,
   723	        ch_fai_genome_withoutmeta,
   724	        ch_dict_genome_withoutmeta
   725	    )
   726	    ch_applyvqsr_indel_snp=ch_vcf_tbi_vqsr_indel_snp.join(
   727	        GATK4_VARIANTRECALIBRATOR_SNP.out.recal).join(
   728	        GATK4_VARIANTRECALIBRATOR_SNP.out.idx).join(
   729	        GATK4_VARIANTRECALIBRATOR_SNP.out.tranches)    
   730	    GATK4_APPLYVQSR_SNP(
   731	        ch_applyvqsr_indel_snp,
   732	        ch_fasta_genome_withoutmeta,
   733	        ch_fai_genome_withoutmeta,
   734	        ch_dict_genome_withoutmeta
   735	    )
   736	    ch_vcf_tbi_intervals_selectvariants_snp_vq=GATK4_APPLYVQSR_SNP.out.vcf.join(GATK4_APPLYVQSR_SNP.out.tbi).map{
   737	        it-> tuple(['id':'snp'],it[1],it[2],file("NOFILE"))
   738	    }
   739	    ch_vcf_tbi_intervals_selectvariants_indel_vq=GATK4_APPLYVQSR_SNP.out.vcf.join(GATK4_APPLYVQSR_SNP.out.tbi).map{
   740	        it-> tuple(['id':'indel'],it[1],it[2],file("NOFILE"))
   741	    }
   742	    GATK4_SELECTVARIANTS_SNP_VQ(
   743	        ch_vcf_tbi_intervals_selectvariants_snp_vq
   744	    )
   745	    GATK4_SELECTVARIANTS_INDEL_VQ(
   746	        ch_vcf_tbi_intervals_selectvariants_indel_vq
   747	    )
   748	    ch_vcf_tbi_fil_pass_variant_vq=GATK4_SELECTVARIANTS_SNP_VQ.out.vcf.join(GATK4_SELECTVARIANTS_SNP_VQ.out.tbi).concat(
   749	        GATK4_SELECTVARIANTS_INDEL_VQ.out.vcf.join(GATK4_SELECTVARIANTS_INDEL_VQ.out.tbi)).concat(
   750	        GATK4_APPLYVQSR_SNP.out.vcf.join(GATK4_APPLYVQSR_SNP.out.tbi))
   751	    FILTER_PASS_VARIANT_VQ(
   752	        ch_vcf_tbi_fil_pass_variant_vq
   753	    )
   754	    GATK4_INDEXFEATUREFILE_VQ(
   755	        FILTER_PASS_VARIANT_VQ.out.vcf
   756	    )
   757	    emit:
   758	    ch_vcf_tbi_annotable = FILTER_PASS_VARIANT_VQ.out.vcf.map{it-> if(it[0].id=='snp'){it}}.join(
   759	        GATK4_INDEXFEATUREFILE_VQ.out.index.map{it-> if(it[0].id=='snp'){it}}).map{it-> tuple(['id':'ANNO'],it[1],it[2])}
   760	    ch_vcf_tbi_structure_vcfaddid=FILTER_PASS_VARIANT_VQ.out.vcf.map{it-> if(it[0].id=='snp'){it}}.join( GATK4_INDEXFEATUREFILE_VQ.out.index.map{it-> if(it[0].id=='snp'){it}}).map{it-> tuple(['id':'popu_snp'],it[1],it[2])}  
   761	    ch_vcf_tbi_pca_vcfaddid=FILTER_PASS_VARIANT_VQ.out.vcf.map{it-> if(it[0].id=='snp'){it}}.join(    GATK4_INDEXFEATUREFILE_VQ.out.index.map{it-> if(it[0].id=='snp'){it}}).map{it-> tuple(it[1],it[2])}
   762	    ch_groups_vcf_emmax_groupping=FILTER_PASS_VARIANT_VQ.out.vcf.map{it-> if(it[0].id=='snp'){it}}.join(GATK4_INDEXFEATUREFILE_VQ.out.index.map{it-> if(it[0].id=='snp'){it}}).map{it-> tuple(['id':'popu_snp'],0,it[1],it[2])}
   763	}
   764	include { STURCTURE_VCF_ADDID           } from '../../../modules/local/structure_vcfaddid'
   765	include { PLINK_INDEP                   } from '../../../modules/nf-core/plink/indep/main'
   766	include { PLINK_EXTRACT                 } from '../../../modules/nf-core/plink/extract/main'
   767	include { ADMIXTURE                     } from '../../../modules/nf-core/admixture/main'
   768	workflow STRUCTURE {
   769	    take:
   770	    ch_vcf_tbi_structure_vcfaddid
   771	    main:
   772	    ch_vcf_tbi_structure_vcfaddid=ch_vcf_tbi_structure_vcfaddid
   773	    //ch_vcf_tbi_structure_vcfaddid.view()
   774	    STURCTURE_VCF_ADDID(
   775	        ch_vcf_tbi_structure_vcfaddid
   776	    )
   777	    ch_vcf_tbi_plink_indep=STURCTURE_VCF_ADDID.out.vcf
   778	    PLINK_INDEP(
   779	        ch_vcf_tbi_plink_indep
   780	    )
   781	    ch_vcf_tbi_prunein_plink_extract=ch_vcf_tbi_plink_indep.join(PLINK_INDEP.out.prunein)
   782	    PLINK_EXTRACT(
   783	        ch_vcf_tbi_prunein_plink_extract
   784	    )
   785	    ch_bed_bim_fam_k_admixture=PLINK_EXTRACT.out.bed.join(PLINK_EXTRACT.out.bim).join(PLINK_EXTRACT.out.fam).combine(Channel.from(2,3,4,5,6,7,8,9,10)).map{
   786	        it -> tuple(['id':"popu_snp_${it[4]}"],it[1],it[2],it[3],it[4])
   787	    }
   788	    //ch_bed_bim_fam_k_admixture.view()
   789	    ADMIXTURE(
   790	        ch_bed_bim_fam_k_admixture
   791	    )
   792	            //    R_STRUCTURE_PLOT()
   793	   emit:
   794	   ch_plink_indep_prunein = PLINK_INDEP.out.prunein
   795	}
   796	include { GATK4_CREATESEQUENCEDICTIONARY                           } from '../../../modules/nf-core/gatk4/createsequencedictionary/main'
   797	include { GATK4_HAPLOTYPECALLER as GATK4_HAPLOTYPECALLER_PREPARE   } from '../../../modules/nf-core/gatk4/haplotypecaller/main'
   798	include { GATK4_SELECTVARIANTS as GATK4_SELECTVARIANTS_SNP         } from '../../../modules/nf-core/gatk4/selectvariants/main'
   799	include { GATK4_SELECTVARIANTS as GATK4_SELECTVARIANTS_INDEL       } from '../../../modules/nf-core/gatk4/selectvariants/main'
   800	include { GATK4_VARIANTFILTRATION as GATK4_VARIANTFILTRATION_SNP   } from '../../../modules/nf-core/gatk4/variantfiltration/main'
   801	include { GATK4_VARIANTFILTRATION as GATK4_VARIANTFILTRATION_INDEL } from '../../../modules/nf-core/gatk4/variantfiltration/main'
   802	include { GATK4_SELECTVARIANTS as GATK4_SELECTVARIANTS_SNP_BQ      } from '../../../modules/nf-core/gatk4/selectvariants/main'
   803	include { GATK4_SELECTVARIANTS as GATK4_SELECTVARIANTS_INDEL_BQ    } from '../../../modules/nf-core/gatk4/selectvariants/main'
   804	include { GATK4_BASERECALIBRATOR                                   } from '../../../modules/nf-core/gatk4/baserecalibrator/main'
   805	include { GATK4_APPLYBQSR                                          } from '../../../modules/nf-core/gatk4/applybqsr/main'
   806	include { GATK4_BASERECALIBRATOR as GATK4_BASERECALIBRATOR_FORSTAT } from '../../../modules/nf-core/gatk4/baserecalibrator/main'
   807	include { SAMTOOLS_INDEX as SAMTOOLS_INDEX_BQSR                    } from '../../../modules/nf-core/samtools/index/main'
   808	include { GATK4_ANALYZECOVARIATES                                  } from '../../../modules/local/gatk4_analyzecovariates'
   809	include { GATK4_HAPLOTYPECALLER as GATK4_HAPLOTYPECALLER_GVCF      } from '../../../modules/nf-core/gatk4/haplotypecaller/main'
   810	include { SAMTOOLS_VIEW as SAMTOOLS_VIEW_FIL20                     } from '../../../modules/nf-core/samtools/view/main'
   811	include { PICARD_SORTSAM                                           } from '../../../modules/nf-core/picard/sortsam/main'
   812	include { SAMTOOLS_FAIDX                                           } from '../../../modules/nf-core/samtools/faidx/main'
   813	include { PICARD_MARKDUPLICATES                                    } from '../../../modules/nf-core/picard/markduplicates/main'
   814	include { SAMTOOLS_INDEX as SAMTOOLS_INDEX_VARIANT_CALLING         } from '../../../modules/nf-core/samtools/index/main'
   815	include { PICARD_COLLECTMULTIPLEMETRICS                            } from '../../../modules/nf-core/picard/collectmultiplemetrics/main'
   816	include { PICARD_COLLECTINSERTSIZEMETRICS                          } from '../../../modules/nf-core/picard/collectinsertsizemetrics/main'
   817	include { SAMTOOLS_DEPTH                                           } from '../../../modules/nf-core/samtools/depth/main'
   818	include { PICARD_ADDORREPLACEREADGROUPS                            } from '../../../modules/nf-core/picard/addorreplacereadgroups/main' 
   819	include { SAMTOOLS_INDEX as SAMTOOLS_INDEX_MAPPING                 } from '../../../modules/nf-core/samtools/index/main'
   820	include { QUALIMAP_BAMQC                                           } from '../../../modules/nf-core/qualimap/bamqc/main'
   821	workflow VARIANT{
   822	        take:
   823	        ch_bwamem2_men_bam
   824	        main:
   825	        def bwaidx_meta='fasta'
   826	        ch_fasta_genome_withmeta=tuple(bwaidx_meta, file(params.fasta))
   827	        ch_fasta_genome_withoutmeta=file(params.fasta)
   828	        PICARD_ADDORREPLACEREADGROUPS(
   829	        ch_bwamem2_men_bam
   830	        )
   831	        ch_bam_to_fil = PICARD_ADDORREPLACEREADGROUPS.out.bam
   832	        SAMTOOLS_INDEX_MAPPING(
   833	            PICARD_ADDORREPLACEREADGROUPS.out.bam
   834	        )
   835	        ch_samtools_index_mapping_bai = SAMTOOLS_INDEX_MAPPING.out.bai
   836	        QUALIMAP_BAMQC(
   837	            PICARD_ADDORREPLACEREADGROUPS.out.bam,
   838	            file("NOFILE")
   839	        )
   840	            // start sample variants calling
   841	        ch_bam_to_fil=PICARD_ADDORREPLACEREADGROUPS.out.bam
   842	        ch_bam_bai_to_fil=ch_bam_to_fil.join(ch_samtools_index_mapping_bai)       
   843	        SAMTOOLS_VIEW_FIL20(
   844	            ch_bam_bai_to_fil,
   845	            ch_fasta_genome_withmeta,
   846	            file("NOFILE")
   847	        )
   848	        PICARD_SORTSAM(
   849	            SAMTOOLS_VIEW_FIL20.out.bam,
   850	            "coordinate"
   851	        )
   852	        SAMTOOLS_FAIDX(
   853	            ch_fasta_genome_withmeta
   854	        )
   855	        ch_fai_genome_withoutmeta=SAMTOOLS_FAIDX.out.fai.collect().flatten().toList().map{it -> it[1]}
   856	        PICARD_MARKDUPLICATES(
   857	            PICARD_SORTSAM.out.bam,
   858	            ch_fasta_genome_withmeta,
   859	            SAMTOOLS_FAIDX.out.fai
   860	        )
   861	        SAMTOOLS_INDEX_VARIANT_CALLING(
   862	            PICARD_MARKDUPLICATES.out.bam
   863	        )
   864	        ch_bam_to_calling=PICARD_MARKDUPLICATES.out.bam
   865	        ch_bam_bai_to_calling=ch_bam_to_calling.join(SAMTOOLS_INDEX_VARIANT_CALLING.out.bai)
   866	        PICARD_COLLECTMULTIPLEMETRICS(
   867	            ch_bam_bai_to_calling,
   868	            ch_fasta_genome_withmeta,
   869	            SAMTOOLS_FAIDX.out.fai        
   870	        )
   871	        PICARD_COLLECTINSERTSIZEMETRICS(
   872	            ch_bam_to_calling       
   873	        )
   874	        depth_meta2="intervals"
   875	        SAMTOOLS_DEPTH(
   876	            ch_bam_to_calling,
   877	            tuple(depth_meta2, file("NOFILE"))
   878	        )
   879	        GATK4_CREATESEQUENCEDICTIONARY(
   880	            ch_fasta_genome_withmeta
   881	        )
   882	        ch_dict_genome_withoutmeta=GATK4_CREATESEQUENCEDICTIONARY.out.dict.collect().flatten().toList().map{it -> it[1]}
   883	        //haplotypecaller_intervals=tuple(file("NOFILE"),file("NOFILE"))
   884	        ch_hap_prepare_calling=ch_bam_bai_to_calling.map{it -> tuple(it[0],it[1],it[2],file("NOFILE1"),file("NOFILE2"))}
   885	        GATK4_HAPLOTYPECALLER_PREPARE(
   886	            ch_hap_prepare_calling,
   887	            ch_fasta_genome_withoutmeta,
   888	            ch_fai_genome_withoutmeta,
   889	            ch_dict_genome_withoutmeta,
   890	            file("NOFILE4"),
   891	            file("NOFILE5")
   892	        )
   893	        ch_vcf_tbi_selectvariants=GATK4_HAPLOTYPECALLER_PREPARE.out.vcf.join(GATK4_HAPLOTYPECALLER_PREPARE.out.tbi)
   894	        ch_vcf_tbi_intervals_selectvariants=ch_vcf_tbi_selectvariants.map{
   895	            it -> tuple(it[0],it[1],it[2],file("NOFILE"))
   896	        }
   897	        GATK4_SELECTVARIANTS_SNP(
   898	            ch_vcf_tbi_intervals_selectvariants
   899	        )
   900	        GATK4_SELECTVARIANTS_INDEL(
   901	            ch_vcf_tbi_intervals_selectvariants
   902	        )
   903	        ch_tbi_variantfil_snp=GATK4_SELECTVARIANTS_SNP.out.vcf
   904	        ch_vcf_tbi_variantfil_snp=ch_tbi_variantfil_snp.join(GATK4_SELECTVARIANTS_SNP.out.tbi)
   905	        index_fai_variantfil='fai'
   906	        index_dict_variantfil='dict'
   907	        GATK4_VARIANTFILTRATION_SNP(
   908	            ch_vcf_tbi_variantfil_snp,
   909	            ch_fasta_genome_withmeta,
   910	            SAMTOOLS_FAIDX.out.fai,
   911	            GATK4_CREATESEQUENCEDICTIONARY.out.dict
   912	        )
   913	        ch_tbi_variantfil_indel=GATK4_SELECTVARIANTS_INDEL.out.vcf
   914	        ch_vcf_tbi_variantfil_indel=ch_tbi_variantfil_indel.join(GATK4_SELECTVARIANTS_INDEL.out.tbi)
   915	        GATK4_VARIANTFILTRATION_INDEL(
   916	            ch_vcf_tbi_variantfil_indel,
   917	            ch_fasta_genome_withmeta,
   918	            SAMTOOLS_FAIDX.out.fai,
   919	            GATK4_CREATESEQUENCEDICTIONARY.out.dict
   920	        )
   921	        ch_vcf_tbi_selectvariants_snp_forbq=GATK4_VARIANTFILTRATION_SNP.out.vcf.join(GATK4_VARIANTFILTRATION_SNP.out.tbi)
   922	        ch_vcf_tbi_intervals_selectvariants_snp_forbq=ch_vcf_tbi_selectvariants_snp_forbq.map{
   923	            it -> tuple(it[0],it[1],it[2],file("NOFILE"))
   924	        }
   925	        GATK4_SELECTVARIANTS_SNP_BQ(
   926	            ch_vcf_tbi_intervals_selectvariants_snp_forbq
   927	        )
   928	        ch_vcf_tbi_selectvariants_indel_forbq=GATK4_VARIANTFILTRATION_INDEL.out.vcf.join(GATK4_VARIANTFILTRATION_INDEL.out.tbi)
   929	        ch_vcf_tbi_intervals_selectvariants_indel_forbq=ch_vcf_tbi_selectvariants_indel_forbq.map{
   930	            it -> tuple(it[0],it[1],it[2],file("NOFILE"))
   931	        }
   932	        GATK4_SELECTVARIANTS_INDEL_BQ(
   933	            ch_vcf_tbi_intervals_selectvariants_indel_forbq
   934	        )
   935	        ch_vcf_bqsr=GATK4_SELECTVARIANTS_SNP_BQ.out.vcf.join(GATK4_SELECTVARIANTS_INDEL_BQ.out.vcf)
   936	        ch_tbi_bqsr=GATK4_SELECTVARIANTS_SNP_BQ.out.tbi.join(GATK4_SELECTVARIANTS_INDEL_BQ.out.tbi)
   937	        ch_bam_bqsr=PICARD_MARKDUPLICATES.out.bam.join(SAMTOOLS_INDEX_VARIANT_CALLING.out.bai)
   938	        ch_bam_vcf_tbi_intervals_bqsr_join=ch_bam_bqsr.join(ch_vcf_bqsr).join(ch_tbi_bqsr)
   939	        ch_bam_vcf_tbi_intervals_bqsr=ch_bam_vcf_tbi_intervals_bqsr_join.map{
   940	                                            it -> 
   941	                                            def vcfforbqsr = [it[3],it[4]]
   942	                                            def tbiforbqsr = [it[5],it[6]]
   943	                                            tuple(it[0],it[1],it[2],file("NOFILE1"),vcfforbqsr,tbiforbqsr)
   944	                                        }
   945	        GATK4_BASERECALIBRATOR(
   946	            ch_bam_vcf_tbi_intervals_bqsr,
   947	            ch_fasta_genome_withoutmeta,
   948	            ch_fai_genome_withoutmeta,
   949	            ch_dict_genome_withoutmeta
   950	        )
   951	        ch_bam_bai_table_intervals_applybqsr=ch_bam_bqsr.join(GATK4_BASERECALIBRATOR.out.table).map{it -> tuple(it[0],it[1],it[2],it[3],file("NOFILE1"))}
   952	        GATK4_APPLYBQSR(
   953	            ch_bam_bai_table_intervals_applybqsr,
   954	            ch_fasta_genome_withoutmeta,
   955	            ch_fai_genome_withoutmeta,
   956	            ch_dict_genome_withoutmeta
   957	        )
   958	        SAMTOOLS_INDEX_BQSR(
   959	            GATK4_APPLYBQSR.out.bam
   960	        )
   961	        ch_bam_bqsr_stat=GATK4_APPLYBQSR.out.bam.join(SAMTOOLS_INDEX_BQSR.out.bai)
   962	        ch_bam_vcf_tbi_intervals_bqsrforstat_join=ch_bam_bqsr_stat.join(ch_vcf_bqsr).join(ch_tbi_bqsr)
   963	        ch_bam_vcf_tbi_intervals_bqsrforstat=ch_bam_vcf_tbi_intervals_bqsrforstat_join.map{
   964	                                            it -> 
   965	                                            def vcfforbqsr = [it[3],it[4]]
   966	                                            def tbiforbqsr = [it[5],it[6]]
   967	                                            tuple(it[0],it[1],it[2],file("NOFILE1"),vcfforbqsr,tbiforbqsr)
   968	                                        }
   969	        GATK4_BASERECALIBRATOR_FORSTAT(
   970	            ch_bam_vcf_tbi_intervals_bqsrforstat,
   971	            ch_fasta_genome_withoutmeta,
   972	            ch_fai_genome_withoutmeta,
   973	            ch_dict_genome_withoutmeta
   974	        )
   975	        ch_before_after_bqsr_analysis=GATK4_BASERECALIBRATOR.out.table.join(GATK4_BASERECALIBRATOR_FORSTAT.out.table)
   976	        GATK4_ANALYZECOVARIATES(
   977	            ch_before_after_bqsr_analysis
   978	        )
   979	        haplotypecaller_intervals=tuple(file("NOFILE1"),file("NOFILE2"))
   980	        ch_hap_gvcf_calling=ch_bam_bqsr_stat.map{it -> tuple(it[0],it[1],it[2],file("NOFILE1"),file("NOFILE2"))}
   981	        GATK4_HAPLOTYPECALLER_GVCF(
   982	            ch_hap_gvcf_calling,
   983	            ch_fasta_genome_withoutmeta,
   984	            ch_fai_genome_withoutmeta,
   985	            ch_dict_genome_withoutmeta,
   986	            file("NOFILE4"),
   987	            file("NOFILE5")
   988	        )
   989	    emit:
   990	    ch_gvcf_dbimport           = GATK4_HAPLOTYPECALLER_GVCF.out.vcf.map{ it -> it[1]}.collect().toList()
   991	    ch_tbi_dbimport            = GATK4_HAPLOTYPECALLER_GVCF.out.tbi.map{ it -> it[1]}.collect().toList()
   992	}
   993	process ANNO_CONVERT2ANNOVAR {
   994	    tag "${meta.id}"
   995	    label 'process_single'
   996	    //conda "${moduleDir}/environment.yml"
   997	    container "${'https://singularity/annovar-with-perl'}"
   998	    input:
   999	    tuple val(meta), path(vcf),path(tbi)
  1000	    output:
  1001	    tuple val(meta), path("*.var"), emit: anno
  1002	    path "versions.yml"             , emit: versions
  1003	    when:
  1004	    task.ext.when == null || task.ext.when
  1005	    script:
  1006	    def prefix = task.ext.prefix ?: "${meta.id}"
  1007	    def args = task.ext.args ?: ''
  1008	    """
  1009	    convert2annovar.pl \
  1010	        -format vcf4 \
  1011	        -allsample \
  1012	        -withfreq \
  1013	        $vcf > ./${prefix}.var
  1014	    cat <<-END_VERSIONS > versions.yml
  1015	    "${task.process}":
  1016	        table_annovar: \$(echo \$(table_annovar.pl version 2>&1) )
  1017	    END_VERSIONS
  1018	    """
  1019	}
  1020	process ANNO_RETRIEVE_SEQ {
  1021	    tag "${meta.id}"
  1022	    label 'process_single'
  1023	    //conda "${moduleDir}/environment.yml"
  1024	    container "${'https://singularity/annovar-with-perl'}"
  1025	    input:
  1026	    tuple val(meta), path(genepred), path(fasta)
  1027	    output:
  1028	    tuple val(meta), path("*_refGeneMrna.fa"), emit: fa
  1029	    path "versions.yml"             , emit: versions
  1030	    when:
  1031	    task.ext.when == null || task.ext.when
  1032	    script:
  1033	    def prefix = task.ext.prefix ?: "${meta.id}"
  1034	    def args = task.ext.args ?: ''
  1035	    """
  1036	    retrieve_seq_from_fasta.pl \\
  1037	        --format refGene \\
  1038	        --seqfile $fasta \\
  1039	        $genepred \\
  1040	        --out ${prefix}.fa
  1041	    cat <<-END_VERSIONS > versions.yml
  1042	    "${task.process}":
  1043	        retrieve_seq_from_fasta: \$(echo \$(retrieve_seq_from_fasta.pl version 2>&1) )
  1044	    END_VERSIONS
  1045	    """
  1046	}
  1047	process ANNO_GFF3TOGENEPRED {
  1048	    tag "${meta.id}"
  1049	    label 'process_single'
  1050	    //conda "${moduleDir}/environment.yml"
  1051	    container "${'https://singularity/annovar-with-perl'}"
  1052	    input:
  1053	    tuple val(meta), path(gff3)
  1054	    output:
  1055	    tuple val(meta), path("*_refGene.txt"), emit: genep
  1056	    path "versions.yml"             , emit: versions
  1057	    when:
  1058	    task.ext.when == null || task.ext.when
  1059	    script:
  1060	    def prefix = task.ext.prefix ?: "${meta.id}"
  1061	    def args = task.ext.args ?: ''
  1062	    """
  1063	    gff3ToGenePred \\
  1064	        $gff3 \\
  1065	        ${prefix} \\
  1066	    cat <<-END_VERSIONS > versions.yml
  1067	    "${task.process}":
  1068	        gff3ToGenePred: \$(echo \$(gff3ToGenePred version 2>&1) )
  1069	    END_VERSIONS
  1070	    """
  1071	}
  1072	process ANNO_TABLE {
  1073	    tag "${meta.id}"
  1074	    label 'process_single'
  1075	    //conda "${moduleDir}/environment.yml"
  1076	    container "${'https://singularity/annovar-with-perl'}"
  1077	    input:
  1078	    tuple val(meta), path(vcf),path(tbi), path(fa), path(fa2), path(gff), path(list),path(anno)
  1079	    output:
  1080	    tuple val(meta), path("*.exonic_variant_function"), emit: annoevf
  1081	    tuple val(meta), path("*.variant_function"), emit: annovf
  1082	    path "versions.yml"             , emit: versions
  1083	    when:
  1084	    task.ext.when == null || task.ext.when
  1085	    script:
  1086	    def prefix = task.ext.prefix ?: "${meta.id}"
  1087	    def args = task.ext.args ?: ''
  1088	    """
  1089	    annotate_variation.pl \\
  1090	        -geneanno \\
  1091	        -dbtype refGene \\
  1092	        -out $prefix \\
  1093	        -build $meta.id\\
  1094	        $anno \\
  1095	        .
  1096	    cat <<-END_VERSIONS > versions.yml
  1097	    "${task.process}":
  1098	        table_annovar: \$(echo \$(table_annovar.pl version 2>&1) )
  1099	    END_VERSIONS
  1100	    """
  1101	    //BUILD_DOC=`find -L ./ -name "*.list" | sed 's/\\${meta.id}_refGene.list\$//'`
  1102	    /*
  1103	    """
  1104	    table_annovar.pl \\
  1105	        $vcf \\
  1106	        . \\
  1107	        -buildver $meta.id \\
  1108	        -out ${prefix}\\
  1109	        -protocol refGene \\
  1110	        -operation g \\
  1111	        -nastring . \\
  1112	        -vcfinput
  1113	    cat <<-END_VERSIONS > versions.yml
  1114	    "${task.process}":
  1115	        table_annovar: \$(echo \$(table_annovar.pl version 2>&1) )
  1116	    END_VERSIONS
  1117	    """
  1118	    */
  1119	}
  1120	process FILTER_PASS_VARIANT {
  1121	    tag "$meta.id"
