     1	include { FASTQS     } from '../subworkflows/nf-core/fastqc'
     2	include { ALIGN      } from '../subworkflows/nf-core/align'
     3	include { VARIANT    } from '../subworkflows/nf-core/variant'
     4	include { POPULATION } from '../subworkflows/nf-core/population'
