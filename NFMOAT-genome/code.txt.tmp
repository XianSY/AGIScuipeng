  1634	    when:
  1635	    task.ext.when == null || task.ext.when
  1636	    script:
  1637	    """
  1638	        knum=\$(grep "CV error" *K*.log|sed 's/.*=//g;s/): /\\t/g'|sort -gk1|awk '{a=prev-\$2;if(NR>1 && a<0){print k;exit;};prev=\$2;k=\$1;}')
  1639	        samplenum=\$(cat $tfam|wc -l)
  1640	        if [ "\$samplenum" -le "\$knum" ]; then
  1641	            ((knum=samplenum-2))
  1642	        fi
  1643	        cat $tfam|awk '{print \$1"\\t"\$1"\\t"1}'|paste - *.\$knum.Q|sed 's/ /\\t/g' > ${meta.id}.emmax.cov
  1644	        grep "CV error" *K*.log|sed 's/.*=//g;s/): /\t/g'|sort -gk1|awk '{print \$1,\$2}' > ${meta.id}.emmax.cverror
  1645	    """
  1646	}
