  3341	    tuple val(meta), path("*.cram"), emit: cram,    optional: true
  3342	    tuple val(meta), path("*.sam"),  emit: sam,     optional: true
  3343	    tuple val(meta), path("*.bai"),  emit: bai,     optional: true
  3344	    tuple val(meta), path("*.csi"),  emit: csi,     optional: true
  3345	    tuple val(meta), path("*.crai"), emit: crai,    optional: true
  3346	    path  "versions.yml",            emit: versions
  3347	    when:
  3348	    task.ext.when == null || task.ext.when
  3349	    script:
  3350	    def args = task.ext.args ?: ''
  3351	    def args2 = task.ext.args2 ?: ''
  3352	    def args3 = task.ext.args3 ?: ''
  3353	    def prefix = task.ext.prefix ?: "${meta.id}"
  3354	    def reference = fasta ? "--reference ${fasta}" : ""
  3355	    def readnames = (qname && !qname.name.contains("NOFILE")) ? "--qname-file ${qname}": ""
  3356	    def file_type = args.contains("--output-fmt sam") ? "sam" :
  3357	                    args.contains("--output-fmt bam") ? "bam" :
  3358	                    args.contains("--output-fmt cram") ? "cram" :
  3359	                    input.getExtension()
  3360	    if ("$input" == "${prefix}${args3}.${file_type}") error "Input and output names are the same, use \"task.ext.prefix\" to disambiguate!"
  3361	    """
  3362	    samtools \\
  3363	        view \\
  3364	        --threads ${task.cpus-1} \\
  3365	        ${reference} \\
  3366	        ${readnames} \\
  3367	        $args \\
  3368	        -o ${prefix}${args3}.${file_type} \\
  3369	        $input \\
  3370	        $args2
  3371	    cat <<-END_VERSIONS > versions.yml
  3372	    "${task.process}":
  3373	        samtools: \$(echo \$(samtools --version 2>&1) | sed 's/^.*samtools //; s/Using.*\$//')
  3374	    END_VERSIONS
  3375	    """
  3376	    stub:
  3377	    def prefix = task.ext.prefix ?: "${meta.id}"
  3378	    """
  3379	    touch ${prefix}.bam
  3380	    touch ${prefix}.cram
  3381	    cat <<-END_VERSIONS > versions.yml
  3382	    "${task.process}":
  3383	        samtools: \$(echo \$(samtools --version 2>&1) | sed 's/^.*samtools //; s/Using.*\$//')
  3384	    END_VERSIONS
  3385	    """
  3386	}
  3387	#!/opt/conda/envs/emmax-anno/bin/Rscript --verbose
  3388	args <- commandArgs(TRUE)
  3389	eigenvec_path = args[1]
  3390	names<-strsplit(eigenvec_path,"/")
  3391	eigenvec_names = names[[1]][length(names[[1]])]
  3392	eigenvec_names = strsplit(eigenvec_names,"\\.")[[1]][1]
  3393	eigenvec_data = read.table(eigenvec_path,header=F)
  3394	eigenvec_data = eigenvec_data[,c(1,2,3,4,5)]
  3395	names(eigenvec_data) = c("ID1","ID2","pca1","pca2","pca3")
  3396	png( 
  3397	  filename = paste(eigenvec_names,'png',sep='.'),
  3398	  width = 1000,
  3399	  height = 800,
  3400	  units = 'px',
  3401	  bg = 'white'
  3402	)
  3403	plot(eigenvec_data$pca1,eigenvec_data$pca2,pch = c(8),col = c("purple"),main="PCA",xlab="pca1",ylab = "pca2")
  3404	dev.off()
  3405	print(paste(eigenvec_names,'png',sep='.'))
  3406	#ggsave(paste(eigenvec_names,'png',sep='.'),p,width=10,height = 10,dpi=300)
  3407	#ggsave(paste(eigenvec_names,'pdf',sep='.'),p,width=10,height = 10,dpi=300)
  3408	#!/opt/conda/envs/emmax-anno/bin/Rscript --verbose
  3409	library("CMplot")
  3410	library("stringr")
  3411	args <- commandArgs(TRUE)
  3412	assocresultfile <- args[1]
  3413	names<-strsplit(assocresultfile,"/")
  3414	name<-names[[1]][length(names[[1]])]
  3415	assocresult<-read.table(assocresultfile,header=F)
  3416	assocresult[,c(5,6)]<-as.data.frame(str_split_fixed(assocresult[,1],":",2))
  3417	assocplot<-assocresult[c(1,5,6,4)]
  3418	colnames(assocplot)<-c("ID","chr","position","P")
  3419	thresholds <- c(0.01,0.05)/nrow(assocplot)
  3420	sigresult <- assocplot[which(assocplot[,"P"]<thresholds[2]),]
  3421	write.table(sigresult,paste0(assocresultfile,"_significant.lst"),sep="\t",row.names=F,quote = FALSE,col.names=T)
  3422	CMplot(assocplot,
  3423	       plot.type = "m",
  3424	       #chr.labels=paste("Chr",c(1:22,"X","Y"),sep=""),
  3425	       file="jpg",
  3426	       file.name = paste0(name,".manh"),
  3427	       dpi=300,
  3428	       file.output=TRUE,verbose=TRUE,width=14,height=6,
  3429	       threshold =c(thresholds,0.000001), #阈值设定，Bonfferoni法校正=0.01/nrow(Pmap)，通常以1/SNP总数为阈值。
  3430	       threshold.col=c('grey','black','black'),#控制阈值线的颜色，注意要对应
  3431	       threshold.lty = c(1,2,2),#阈值线的类型（7为实线，5为虚线）
  3432	       threshold.lwd = c(1,1,1),#阈值线的宽度，也可以调整对角线的宽度，2最合适）
  3433	       amplify = T,#放大显示~显著性的SNP点
  3434	       signal.cex = c(1,1,1),#设置有效SNP位点的大小,建议选用2/3号为宜
  3435	       signal.pch = c(20,20,20),#设置有效SNP位点的形状，16和19为圆形。
  3436	       signal.col =c("red","darkgreen","skyblue"),#有效SNP位点的颜色
  3437	       chr.den.col=c("darkgreen","yellow","red")#【添加SNP密度】！！！,若不想添加只需要到前一步就可结束
  3438	)
  3439	CMplot(assocplot,
  3440	       plot.type="q",
  3441	       threshold = 0.05,
  3442	       conf.int.col=NULL,#绘制QQ图中置信区间的颜色，可以用字符或向量
  3443	       box=TRUE,#是否添加边框
  3444	       file="jpg",
  3445	       file.name = paste0(name,".QQ"),
  3446	       dpi=300,
  3447	       file.output=TRUE,
  3448	       verbose=TRUE,width=10,height=10
  3449	)
  3450	#!/opt/conda/envs/emmax-anno/bin/Rscript --verbose
  3451	args <- commandArgs(TRUE)
  3452	eigenvec_path = args[1]
  3453	names<-strsplit(eigenvec_path,"/")
  3454	cverror_names = names[[1]][length(names[[1]])]
  3455	cverror_names = strsplit(cverror_names,"\\.")[[1]][1]
  3456	cverror_data = read.table(eigenvec_path,header=F)
  3457	names(cverror_data) = c("k","CV")
  3458	png( 
  3459	  filename = paste(cverror_names,'png',sep='.'),
  3460	  width = 1000,
  3461	  height = 800,
  3462	  units = 'px',
  3463	  bg = 'white'
  3464	)
  3465	plot(cverror_data$k,cverror_data$CV,,type = "b",pch = c(21),col = c("black"),bg = "black",lwd = 2,font = 2,font.lab = 2,font.axis = 2,xlab="K value",ylab="Cross-Validation (CV) errors")
  3466	dev.off()
  3467	print(paste(cverror_names,'png',sep='.'))
