  1803	    def args = task.ext.args ?: ''
  1804	    def prefix = task.ext.prefix ?: "${meta.id}"
  1805	    // Make list of old name and new name pairs to use for renaming in the bash while loop
  1806	    def old_new_pairs = reads instanceof Path || reads.size() == 1 ? [[ reads, "${prefix}.${reads.extension}" ]] : reads.withIndex().collect { entry, index -> [ entry, "${prefix}_${index + 1}.${entry.extension}" ] }
  1807	    def rename_to = old_new_pairs*.join(' ').join(' ')
  1808	    def renamed_files = old_new_pairs.collect{ old_name, new_name -> new_name }.join(' ')
