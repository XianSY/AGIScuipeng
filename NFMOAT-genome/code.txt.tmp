    13	*/
    14	include { paramsSummaryLog; paramsSummaryMap } from 'plugin/nf-validation'
    15	def logo = NfcoreTemplate.logo(workflow, params.monochrome_logs)
    16	def citation = '\n' + WorkflowMain.citation(workflow) + '\n'
    17	def summary_params = paramsSummaryMap(workflow)
    18	// Print parameter summary log to screen
